  "keywords": [
    "dsh",
    "dsh-plugin",
    "stellaris",
    "subagent"
  ],
  "license": "MIT",
  "engines": {
    "dsh": ">=0.1.7-rc.1",
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
