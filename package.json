{
  "name": "stellaris-agent",
  "version": "1.0.0",
  "private": true,
  "description": "群星参谋：把 Stellaris 4.5 的状态读出来，交给 DeepSeek/DSH 推理，再通过原生桥执行操作。",
  "type": "module",
  "scripts": {
    "gui": "powershell -NoProfile -ExecutionPolicy Bypass -File agent/gui/StellarisAgent.ps1",
