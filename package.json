    "build:exe": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-exe.ps1",
    "install:dsh": "powershell -NoProfile -ExecutionPolicy Bypass -File dsh-stellaris-bridge/install.ps1"
